# clocks: AD9361 DATA_CLK (LVDS, up to 245.76 MHz on C2 / 32 MHz on C at 8 MS/s x 4 in 2R2T DDR)
create_clock -name ad1_dclk -period 4.069 [get_ports {ad1_dclk_p}]
create_clock -name ad2_dclk -period 4.069 [get_ports {ad2_dclk_p}]
create_clock -name ad3_dclk -period 4.069 [get_ports {ad3_dclk_p}]
set_clock_groups -asynchronous -group [get_clocks -include_generated_clocks clk_fpga_0] -group [get_clocks -include_generated_clocks ad1_dclk] -group [get_clocks -include_generated_clocks ad2_dclk] -group [get_clocks -include_generated_clocks ad3_dclk]
